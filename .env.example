# =============================================================
# TEMPLATE ENVIRONMENT VARIABLE - Sealauk (jastip PO ikan asap)
# =============================================================
# File ini AMAN di-commit karena hanya berisi NAMA variabel.
#
# Cara pakai:
#   cp .env.example .env.local
# lalu isi nilainya di .env.local (file itu sudah di-ignore git).
#
# ATURAN: variabel berawalan NEXT_PUBLIC_ ikut terkirim ke browser
# dan bisa dibaca siapa pun. Yang TANPA prefix itu hanya hidup di
# server - jangan pernah dipakai di komponen client.
# =============================================================

# ---------------------------- SUPABASE ----------------------------
# URL project Supabase. Ambil di: Dashboard > Project Settings > API
# Aman dipublikasikan.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...), bukan legacy anon key.
# Dibatasi Row Level Security, jadi aman di browser selama RLS aktif.
# Ambil di: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA. Secret key (sb_secret_...), atau legacy service_role key.
# Menembus semua Row Level Security: siapa pun yang punya ini bisa
# membaca dan menghapus seluruh database. Hanya dipakai di
# src/lib/server/, yang diberi import "server-only".
SUPABASE_SECRET_KEY=

# ------------------------- CAPTCHA CHECKOUT -------------------------
# Cloudflare Turnstile. Untuk lokal boleh pakai kunci uji resmi
# Cloudflare yang selalu lolos:
#   site key   1x00000000000000000000BB (tanpa tampilan)
#   secret key 1x0000000000000000000000000000000AA
# Di Netlify wajib kunci asli dari dashboard Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# RAHASIA. Garam untuk hash IP pada batas 5 checkout per IP per jam.
# Buat dengan: openssl rand -hex 32
IP_HASH_SALT=

# ---------------------------- MIDTRANS ----------------------------
# RAHASIA. Dipakai server untuk membuat transaksi dan memverifikasi
# signature webhook. Bocornya kunci ini = orang bisa memalsukan
# notifikasi pembayaran "lunas".
MIDTRANS_SERVER_KEY=

# Set "true" saat sudah pakai akun produksi Midtrans.
# Biarkan kosong / "false" selama masih memakai Sandbox.
MIDTRANS_IS_PRODUCTION=false

# ----------------------------- SITUS ------------------------------
# Alamat situs tanpa garis miring di akhir, mis. https://sealauk.id.
# Dipakai untuk tautan kembali dari halaman bayar Midtrans.
# Kosong = diambil dari header permintaan (cukup untuk lokal).
SITE_URL=
