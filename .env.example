# =============================================================
# TEMPLATE ENVIRONMENT VARIABLE - Sekiloo (e-commerce ikan asap)
# =============================================================
# File ini AMAN di-commit karena hanya berisi NAMA variabel.
#
# Cara pakai:
#   cp .env.example .env.local
# lalu isi nilainya di .env.local (file itu sudah di-ignore git).
#
# ATURAN: variabel berawalan NEXT_PUBLIC_ ikut terkirim ke browser
# dan bisa dibaca siapa pun. Yang TANPA prefix itu hanya hidup di
# server - jangan pernah dipakai di komponen client.
# =============================================================

# ---------------------------- SUPABASE ----------------------------
# URL project Supabase. Ambil di: Dashboard > Project Settings > API
# Aman dipublikasikan.
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon). Dibatasi oleh Row Level Security, jadi aman
# di browser SELAMA RLS aktif di setiap tabel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA. Menembus semua Row Level Security - siapa pun yang punya
# ini bisa membaca dan menghapus seluruh database.
# Hanya untuk Route Handler / Server Action. JANGAN pernah diimpor
# ke file berlabel "use client".
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------- MIDTRANS ----------------------------
# RAHASIA. Dipakai server untuk membuat transaksi dan memverifikasi
# signature webhook. Bocornya kunci ini = orang bisa memalsukan
# notifikasi pembayaran "lunas".
MIDTRANS_SERVER_KEY=

# Kunci client untuk Snap.js di browser. Aman dipublikasikan.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Set "true" saat sudah pakai akun produksi Midtrans.
# Biarkan kosong / "false" selama masih memakai Sandbox.
MIDTRANS_IS_PRODUCTION=false
