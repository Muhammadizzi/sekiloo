# Disalin ke .env.local untuk dijalankan lokal, dan diisi di EAS untuk build APK.
# Semua nilai di sini ikut terbawa ke dalam APK dan bisa dibaca siapa pun yang membongkarnya.
# Jangan pernah menaruh secret key Supabase, server key Midtrans, atau kunci rahasia lain di sini.

# URL project Supabase (sama dengan NEXT_PUBLIC_SUPABASE_URL di web).
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Dibatasi RLS, dan semua aksi admin
# tetap dicek di database: peran di admin_roles plus sesi 2FA.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alamat web pembeli tanpa garis miring di akhir, mis. https://sealauk.id.
# Dipakai untuk link status pesanan di pesan WhatsApp dan untuk menyegarkan
# cache katalog web setelah produk, wilayah, atau kloter diubah.
EXPO_PUBLIC_SITE_URL=
